{
  "expo": {
    "name": "রংধনু",
    "slug": "temp-expo",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./image/mylogo.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./image/mylogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./image/mylogo.png"
      },
      "package": "com.riajulshakib.rongdhonu",
      "versionCode": 2
    },
    "web": {
      "favicon": "./image/mylogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "5bbb3050-c514-4ce8-88f4-655a9cec68ba"
      }
    },
    "owner": "shakib223"
  }
}
