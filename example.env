# =========================================================================
# RONGDHONU CAFÉ & RESTAURANT - DATABASE CONFIGURATION
# =========================================================================

# -------------------------------------------------------------------------
# Firebase Cloud Firestore Configurations
# -------------------------------------------------------------------------
# Get these values from: https://console.firebase.google.com
# Project Settings > General > Your apps > SDK setup and configuration

EXPO_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key_here"
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project.firebaseapp.com"
EXPO_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project.firebasestorage.app"
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
EXPO_PUBLIC_FIREBASE_APP_ID="your_app_id"

# -------------------------------------------------------------------------
# Master Feature Flags
# -------------------------------------------------------------------------
EXPO_PUBLIC_AI_DATASET_ENABLED="false"

# -------------------------------------------------------------------------
# Google Sheets ML Dataset & Weather Exporter WebApp URLs
# -------------------------------------------------------------------------
# Get this from: Google Apps Script > Deploy > Web App URL
EXPO_PUBLIC_AI_DATASET_WEBAPP_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
EXPO_PUBLIC_WEATHER_WEBAPP_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# -------------------------------------------------------------------------
# Supabase Realtime Device Control & Tracking
# -------------------------------------------------------------------------
# Get these values from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL="https://your_supabase_project_id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_public_key_here"

# -------------------------------------------------------------------------
# Phase 2 Dual-Write Kill Switch & Timeout
# -------------------------------------------------------------------------
# Set to "false" to instantly revert to Firebase-only behavior (dual-write +
# Supabase pull are skipped). Default: true.
EXPO_PUBLIC_SUPABASE_SYNC_ENABLED="true"
# Per-operation Supabase timeout in ms. Default: 4000.
EXPO_PUBLIC_SUPABASE_TIMEOUT_MS="4000"
