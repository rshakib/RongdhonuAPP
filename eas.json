{
  "cli": {
    "version": ">= 9.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "admin": {
      "env": {
        "EXPO_PUBLIC_APP_PROFILE": "ADMIN"
      },
      "channel": "admin",
      "android": {
        "buildType": "apk"
      }
    },
    "owner": {
      "env": {
        "EXPO_PUBLIC_APP_PROFILE": "OWNER"
      },
      "channel": "owner",
      "android": {
        "buildType": "apk"
      }
    },
    "manager": {
      "env": {
        "EXPO_PUBLIC_APP_PROFILE": "MANAGER"
      },
      "channel": "manager",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {}
  },
  "submit": {
    "production": {}
  }
}
