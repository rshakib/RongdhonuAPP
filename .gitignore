# FULL-BACKUP POLICY (private repo)
# Everything is committed so a fresh clone can build and run immediately —
# including .env, credentials/ (signing keystores + passwords), android/, tests/.
# Keep this repository PRIVATE: it now contains the app signing keys.

# dependencies (restore with `npm install`)
node_modules/

# build output
*.apk

# Expo's local cache is machine-specific and regenerated on every `expo start`;
# keeping it out stops the working tree from going dirty after each run.
.expo/
